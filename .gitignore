report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz
# ...except the Helm subchart this generic rule was accidentally also
# catching: deploy/redinfo/charts/postgresql-*.tgz is meant to be vendored
# (see Chart.lock, which pins it) so `helm upgrade` never needs a network
# fetch from the deprecated Bitnami chart repo at deploy time — un-ignore it
# specifically rather than widen the rule. Caught live: it was silently
# missing from every checkout but this machine's, so `helm upgrade --install`
# failed on the self-hosted agent the first time --dependency-update was
# removed from the pipeline (see .ado/templates/deploy-env.yml).
!deploy/redinfo/charts/*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.*
!.env.example

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist
prisma-dist

