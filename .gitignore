.pnpm-store/

# Prisma migrations (keep in source control — remove this line if desired)
# packages/backend/prisma/migrations/

# Build outputs
packages/*/dist/
packages/*/build/

# Prevent accidentally generated TS build outputs in source folders
packages/*/*.js
packages/*/*.js.map
packages/*/*.d.ts
packages/*/*.d.ts.map

# IDE
.idea/

# OS
.DS_Store
Thumbs.db

# Legacy migration: raw dumps and per-run output can contain real personal/
# clinical data pulled from the production MySQL system. Never committed.
migration/dump/
migration/out/

# Operator manual: generated binaries (screenshots + PDF). Regenerate locally with
# docs/manual-operador/capture-screenshots.mjs and generate-pdf.mjs — never commit the output.
docs/manual-operador/images/
docs/manual-operador/manual_emergencyoperator.pdf

# Routing/geocoding (#231): the OSM extract and OSRM's pre-processed `.osrm*`
# files. Multi-hundred-MB, reproducible from scripts/prepare-osrm-data.sh —
# never committed.
/data/routing/

# Self-hosted basemap (#247 stage 4): the PMTiles extract the `tiles`
# service serves. Multi-hundred-MB, reproducible from
# scripts/prepare-basemap.sh — never committed.
/data/basemap/

# Terraform (infra/terraform). `.terraform/` is downloaded providers; the state
# files are only ever local leftovers (the real state lives in S3 — see
# infra/terraform/versions.tf) and are a plaintext dump of the environment.
# `.terraform.lock.hcl` is deliberately NOT ignored: it pins provider hashes
# and belongs in review.
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
# Real values for the example files next to them. Nothing secret should be in
# terraform.tfvars, but it is machine-specific; backend.hcl names the state
# bucket, which is not something to publish.
infra/terraform/terraform.tfvars
infra/terraform/*.auto.tfvars
infra/terraform/backend.hcl
