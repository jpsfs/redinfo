# ─── Database ───────────────────────────────────────────────────────────────
POSTGRES_USER=redinfo
POSTGRES_PASSWORD=redinfo_dev_password
POSTGRES_DB=redinfo
DATABASE_URL=postgresql://redinfo:redinfo_dev_password@postgres:5432/redinfo

# ─── Backend ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# JWT
JWT_SECRET=change_this_to_a_random_secret_at_least_64_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── OAuth — Google ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Dev:  http://localhost:3000/auth/google/callback
# Prod: https://yourdomain.com/api/auth/google/callback  (via nginx)
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ─── OAuth — Microsoft ───────────────────────────────────────────────────────
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_TENANT_ID=common
# Dev:  http://localhost:3000/auth/microsoft/callback
# Prod: https://yourdomain.com/api/auth/microsoft/callback  (via nginx)
MICROSOFT_CALLBACK_URL=http://localhost:3000/auth/microsoft/callback

# ─── Frontend ────────────────────────────────────────────────────────────────
# Dev (Vite dev server proxies to backend directly):
VITE_API_URL=http://localhost:3000
# Prod (nginx proxies /api/* → backend) — set as Docker build-arg instead:
# docker compose -f ... build --build-arg VITE_API_URL=/api frontend

# ─── Google Maps ─────────────────────────────────────────────────────────────
# Routes API key, used server-side to compute report distance
# (Base → occurrence → hospital → Base). Requires billing enabled on the
# Google Cloud project even to use the free tier.
# BACKEND ONLY — never expose as VITE_*, or it ships in the browser bundle
# and gets scraped.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ─── Live emergency mode ─────────────────────────────────────────────────────
# Column-encryption keys for the identity fields a live run holds (victim name,
# date of birth, SNS number, occurrence address). Comma-separated `id:base64`;
# the FIRST key encrypts, ALL of them decrypt — which is what makes rotation a
# restart rather than a re-encryption pass. Each must decode to exactly 32 bytes.
#
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Rotating: prepend a new key and restart. Every blob is destroyed within 48h of
# its run closing, so the old key can be dropped after one retention window.
#
# `prisma migrate deploy` runs from the image entrypoint, so this must be in the
# environment BEFORE that restart or the live-runs module fails init.
IDENTITY_ENCRYPTION_KEYS=k1:replace_me_with_a_32_byte_base64_key
