# ─── Database ───────────────────────────────────────────────────────────────
POSTGRES_USER=redinfo
POSTGRES_PASSWORD=redinfo_dev_password
POSTGRES_DB=redinfo
DATABASE_URL=postgresql://redinfo:redinfo_dev_password@postgres:5432/redinfo

# A second server (`postgres-test` in docker-compose.override.yml — dev only,
# never loaded in production), so `pnpm test:integration` never touches the
# database above. `test:integration` wipes and re-migrates this one on every
# run; never point it at the same database as DATABASE_URL.
POSTGRES_TEST_DB=redinfo_test
TEST_DATABASE_URL=postgresql://redinfo:redinfo_dev_password@postgres-test:5432/redinfo_test

# ─── Backend ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Where uploaded files live — event report attachments, certification
# documents, profile photos. Must be a mounted volume in every environment
# that matters, or a redeploy loses everything under it.
ATTACHMENTS_DIR=./uploads

# JWT
JWT_SECRET=change_this_to_a_random_secret_at_least_64_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── OAuth — Google ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Dev:  http://localhost:3000/auth/google/callback
# Prod: https://yourdomain.com/api/auth/google/callback  (via nginx)
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ─── OAuth — Microsoft ───────────────────────────────────────────────────────
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_TENANT_ID=common
# Dev:  http://localhost:3000/auth/microsoft/callback
# Prod: https://yourdomain.com/api/auth/microsoft/callback  (via nginx)
MICROSOFT_CALLBACK_URL=http://localhost:3000/auth/microsoft/callback

# ─── Frontend ────────────────────────────────────────────────────────────────
# Dev: relative path, proxied to the backend by Vite (see packages/frontend/vite.config.ts).
# Using a relative URL (instead of an absolute http://localhost:3000) is what lets
# the app be reached from other machines as http://<any-host-or-ip>:5173.
VITE_API_URL=/api
# Prod (nginx proxies /api/* → backend) — set as Docker build-arg instead:
# docker compose -f ... build --build-arg VITE_API_URL=/api frontend

# ─── Google Maps ─────────────────────────────────────────────────────────────
# Routes API key, used server-side to compute report distance
# (Base → occurrence → hospital → Base). Requires billing enabled on the
# Google Cloud project even to use the free tier.
# BACKEND ONLY — never expose as VITE_*, or it ships in the browser bundle
# and gets scraped.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ─── Live emergency mode ─────────────────────────────────────────────────────
# Column-encryption keys for the identity fields a live run holds (victim name,
# date of birth, SNS number, occurrence address). Comma-separated `id:base64`;
# the FIRST key encrypts, ALL of them decrypt — which is what makes rotation a
# restart rather than a re-encryption pass. Each must decode to exactly 32 bytes.
#
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Rotating: prepend a new key and restart. Every blob is destroyed within 48h of
# its run closing, so the old key can be dropped after one retention window.
#
# `prisma migrate deploy` runs from the image entrypoint, so this must be in the
# environment BEFORE that restart or the live-runs module fails init.
IDENTITY_ENCRYPTION_KEYS=k1:replace_me_with_a_32_byte_base64_key

# ─── Legacy migration (MIGRATION ONLY) ───────────────────────────────────────
# Read by `pnpm --filter backend migrate:legacy` and by nothing else. The API
# never touches these, so they are deliberately absent from
# scripts/validate-env.js: a deploy that has no legacy import to run must not
# fail its env gate over variables its running process never reads.
#
# `mysql-legacy` is the throwaway MariaDB in docker-compose.migration.yml,
# loaded from migration/dump/*.sql. It is never a live legacy server: the
# loader reads a dump, so a bad SELECT cannot slow down the system the
# delegation is still using to answer calls.
LEGACY_MYSQL_HOST=mysql-legacy
LEGACY_MYSQL_PORT=3306
LEGACY_MYSQL_USER=root
LEGACY_MYSQL_PASSWORD=legacy_dev_password
LEGACY_MYSQL_DATABASE=u127939263_cvp

# The wall-clock zone the legacy system recorded dates and times in. Legacy
# stores DATE and TIME with no offset; Postgres columns are timestamps written
# as UTC by Prisma, so without this every occurrence lands an hour out for half
# the year. Change only if the delegation's records were kept in another zone.
LEGACY_TIMEZONE=Europe/Lisbon

# The system actor every imported row is attributed to. Upserted by the loader
# as an inactive, password-less SYSTEM_ADMIN — see §6 of migration/README.md.
LEGACY_IMPORT_ACTOR_EMAIL=import@redinfo.invalid
