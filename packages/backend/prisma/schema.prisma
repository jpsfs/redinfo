// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SYSTEM_ADMIN
  EMERGENCY_OPERATIONAL
  EMERGENCY_COORDINATOR
  LOGISTICS_COORDINATOR
}

enum AuthProvider {
  LOCAL
  GOOGLE
  MICROSOFT
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  firstName    String
  lastName     String
  passwordHash String?
  role         UserRole     @default(EMERGENCY_OPERATIONAL)
  provider     AuthProvider @default(LOCAL)
  providerId   String?
  isActive     Boolean      @default(true)
  isDriver     Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  refreshTokens RefreshToken[]

  windowsOpened           AvailabilityWindow[]     @relation("WindowOpenedBy")
  windowsClosed           AvailabilityWindow[]     @relation("WindowClosedBy")
  availabilitySubmissions AvailabilitySubmission[]
  availabilityResponses   AvailabilityResponse[]

  schedulesCreated    Schedule[]           @relation("ScheduleCreatedBy")
  schedulesPublished  Schedule[]           @relation("SchedulePublishedBy")
  scheduleAssignments ScheduleAssignment[] @relation("ScheduleAssignedTo")
  assignmentsMade     ScheduleAssignment[] @relation("ScheduleAssignedBy")

  eventReportsCreated    EventReport[]           @relation("EventReportCreatedBy")
  eventReportCrew        EventReportCrewMember[]
  eventReportAttachments EventReportAttachment[] @relation("EventReportAttachmentUploadedBy")

  @@index([email])
  @@index([provider, providerId])
  @@index([isActive, role])
}

model RefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
}

enum VehicleType {
  EMERGENCY
  TRANSPORT
}

model Vehicle {
  id                    String      @id @default(cuid())
  licensePlate          String      @unique
  numeroCauda           String      @unique
  vehicleType           VehicleType
  insuranceRenewalDate  DateTime    @db.Date
  nextImtInspectionDate DateTime    @db.Date
  manufacturer          String?
  model                 String?
  notes                 String?
  isDeleted             Boolean     @default(false)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  maintenanceEntries    MaintenanceEntry[]
  vehicleInventoryItems VehicleInventoryItem[]
  eventReports          EventReportVehicle[]

  @@index([vehicleType])
  @@index([isDeleted])
}

model MaintenanceEntry {
  id              String   @id @default(cuid())
  vehicleId       String
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  date            DateTime @db.Date
  description     String
  serviceProvider String
  cost            Decimal  @db.Decimal(10, 2)
  vatAmount       Decimal? @db.Decimal(10, 2)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([vehicleId])
}

// ─── Inventory ────────────────────────────────────────────────────────────────

enum InventoryItemType {
  COUNTABLE
  UNLIMITED
}

model InventoryTemplate {
  id          String      @id @default(cuid())
  vehicleType VehicleType @unique
  version     Int         @default(1)
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  items InventoryTemplateItem[]

  @@index([vehicleType])
}

model InventoryTemplateItem {
  id                  String            @id @default(cuid())
  templateId          String
  template            InventoryTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name                String
  type                InventoryItemType @default(COUNTABLE)
  recommendedQuantity Int?
  unit                String            @default("pcs")
  notes               String?
  order               Int               @default(0)
  isDeleted           Boolean           @default(false)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  vehicleInventoryItems VehicleInventoryItem[]

  @@index([templateId])
  @@index([isDeleted])
}

model VehicleInventoryItem {
  id              String                @id @default(cuid())
  vehicleId       String
  vehicle         Vehicle               @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  templateItemId  String
  templateItem    InventoryTemplateItem @relation(fields: [templateItemId], references: [id], onDelete: Cascade)
  actualQuantity  Int?
  templateVersion Int
  updatedById     String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  audits VehicleInventoryAudit[]

  @@unique([vehicleId, templateItemId])
  @@index([vehicleId])
  @@index([templateItemId])
}

model VehicleInventoryAudit {
  id                     String               @id @default(cuid())
  vehicleInventoryItemId String
  vehicleInventoryItem   VehicleInventoryItem @relation(fields: [vehicleInventoryItemId], references: [id], onDelete: Cascade)
  changedById            String?
  oldQuantity            Int?
  newQuantity            Int?
  changedAt              DateTime             @default(now())

  @@index([vehicleInventoryItemId])
}

// ─── Availability ─────────────────────────────────────────────────────────────

enum AvailabilityWindowStatus {
  OPEN
  CLOSED
}

/// Independent rotas. Two windows may cover the same dates as long as their
/// categories differ; within one category only one open window may cover a day.
enum AvailabilityWindowCategory {
  EMERGENCY
  LOCAL_SUPPORT
  SALOP_SUPPORT
}

/// Only DECLINED is ever stored: absence of a row means "not yet responded".
enum AvailabilityResponseStatus {
  DECLINED
}

/// Coordinator-maintained holiday table (no external API). A holiday makes a
/// weekday follow the weekend shift pattern.
model Holiday {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

model AvailabilityWindow {
  id         String                     @id @default(cuid())
  startDate  DateTime                   @db.Date
  endDate    DateTime                   @db.Date
  /// Which rota this window collects availability for. No default on purpose:
  /// every caller states it, so a missing category cannot silently become one.
  category   AvailabilityWindowCategory
  /// Optional free-text title, e.g. "Emergency - October". Not unique.
  name       String?
  status     AvailabilityWindowStatus   @default(OPEN)
  openedById String
  openedBy   User                       @relation("WindowOpenedBy", fields: [openedById], references: [id])
  openedAt   DateTime                   @default(now())
  closedById String?
  closedBy   User?                      @relation("WindowClosedBy", fields: [closedById], references: [id])
  closedAt   DateTime?
  createdAt  DateTime                   @default(now())
  updatedAt  DateTime                   @updatedAt

  submissions AvailabilitySubmission[]
  responses   AvailabilityResponse[]
  shifts      AvailabilityWindowShift[]
  roles       AvailabilityWindowRole[]
  schedule    Schedule?

  @@index([status])
  @@index([startDate, endDate])
  /// Overlap checks are always "this category, these dates".
  @@index([category, status])
}

/// The shifts of one day of one window, materialised when the window is opened.
///
/// Windows carry their own grid rather than deriving it: a coordinator may give
/// any day any times, and a holiday added after the fact must not silently
/// invalidate submissions already made against the day it lands on.
model AvailabilityWindowShift {
  id             String             @id @default(cuid())
  windowId       String
  window         AvailabilityWindow @relation(fields: [windowId], references: [id], onDelete: Cascade)
  date           DateTime           @db.Date
  /// 1-based position within the day, ordered by startMinute. Submissions point here.
  slot           Int
  /// Minutes from midnight the shift starts, 0–1439.
  startMinute    Int
  /// Minutes from midnight it ends, 1–1440 (1440 = midnight).
  endMinute      Int
  /// Vehicles to be crewed on this shift; each needs its own driver, which is
  /// what the coverage colours are judged against. 0 = people only.
  vehiclesNeeded Int

  @@unique([windowId, date, slot])
  @@index([windowId])
}

/// A post the schedule for this window assigns people to.
///
/// Roles hang off the window rather than off a person or a shift: availability
/// is collected without them (a volunteer says only when they can be there) and
/// the coordinator allocates roles when building the schedule.
model AvailabilityWindowRole {
  id                          String             @id @default(cuid())
  windowId                    String
  window                      AvailabilityWindow @relation(fields: [windowId], references: [id], onDelete: Cascade)
  name                        String
  /// Most people the schedule may put in this role on one shift. 0 = unlimited.
  maxPeople                   Int
  /// Only a certified driver may fill this role. Always true for "Driver",
  /// derived from the name rather than chosen, so the rule cannot be turned off.
  requiresDriverCertification Boolean            @default(false)
  /// Position in the window's own role list, 0-based.
  order                       Int

  assignments ScheduleAssignment[]

  /// One post per name: two roles a schedule cannot tell apart are not two roles.
  @@unique([windowId, name])
  @@index([windowId])
}

model AvailabilitySubmission {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  windowId  String
  window    AvailabilityWindow @relation(fields: [windowId], references: [id], onDelete: Cascade)
  date      DateTime           @db.Date
  /// Slot of AvailabilityWindowShift for the same (windowId, date). Not a
  /// foreign key: the shift row is identified by a composite the submission
  /// would otherwise have to duplicate, and slots never move once opened.
  slot      Int
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([windowId, userId, date, slot])
  @@index([windowId])
  @@index([date])
  @@index([userId])
}

enum ScheduleStatus {
  DRAFT
  PUBLISHED
}

/// The duty roster built from one availability window.
///
/// One per window, and identified by it: windows of different categories may
/// cover the same dates, so there is no single "monthly schedule" to hang this
/// off. A schedule may be started while its window is still open — coordinators
/// begin arranging cover before submissions close.
model Schedule {
  id            String             @id @default(cuid())
  windowId      String             @unique
  window        AvailabilityWindow @relation(fields: [windowId], references: [id], onDelete: Cascade)
  status        ScheduleStatus     @default(DRAFT)
  createdById   String
  createdBy     User               @relation("ScheduleCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime           @default(now())
  publishedById String?
  publishedBy   User?              @relation("SchedulePublishedBy", fields: [publishedById], references: [id])
  publishedAt   DateTime?
  updatedAt     DateTime           @updatedAt

  assignments  ScheduleAssignment[]
  /// Reports whose crew was pre-filled from a shift of this schedule.
  eventReports EventReport[]

  @@index([status])
}

/// One person on one shift of one schedule, in at most one role.
model ScheduleAssignment {
  id           String                  @id @default(cuid())
  scheduleId   String
  schedule     Schedule                @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  /// Identified the same way a submission is — by (date, slot) rather than a
  /// foreign key to the shift row. Slots never move once a window is opened, and
  /// this keeps a legacy window with no materialised shifts schedulable.
  date         DateTime                @db.Date
  slot         Int
  userId       String
  user         User                    @relation("ScheduleAssignedTo", fields: [userId], references: [id], onDelete: Cascade)
  /// Null only when the window defines no roles at all.
  roleId       String?
  role         AvailabilityWindowRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)
  /// The person had not submitted availability for this shift when they were
  /// assigned. Computed server-side and never recomputed afterwards: it records
  /// a decision, so a later change of availability must not rewrite history.
  isOverride   Boolean                 @default(false)
  assignedById String
  assignedBy   User                    @relation("ScheduleAssignedBy", fields: [assignedById], references: [id])
  assignedAt   DateTime                @default(now())

  /// One person at most once per shift — the same person in two roles on one
  /// shift is a data error, not a conflict to report.
  @@unique([scheduleId, date, slot, userId])
  @@index([scheduleId])
  @@index([userId, date])
  @@index([date])
}

/// Tri-state response tracking: "submitted" is derived from
/// AvailabilitySubmission rows existing, "declined" needs its own record since
/// row-absence alone cannot tell it apart from "not yet responded".
model AvailabilityResponse {
  id          String                     @id @default(cuid())
  windowId    String
  window      AvailabilityWindow         @relation(fields: [windowId], references: [id], onDelete: Cascade)
  userId      String
  user        User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      AvailabilityResponseStatus @default(DECLINED)
  respondedAt DateTime                   @default(now())

  @@unique([windowId, userId])
  @@index([windowId])
}

// ─── Geography ────────────────────────────────────────────────────────────────

/// A Portuguese municipality (concelho).
///
/// Seeded from `prisma/data/pt-localities.json` (regenerated by
/// `scripts/fetch-pt-localities.mjs`) and never edited in the app: the
/// administrative map is not ours to change.
///
/// The coordinate lives here rather than on `Locality` because its only job is
/// ordering hospitals by distance from where an event happened. Hospitals are
/// tens of kilometres apart and a municipality is a few across, so one
/// coordinate per municipality is precise enough for that ordering — and keeps
/// 3,259 freguesias from each carrying a number nothing reads.
model Municipality {
  id String @id @default(cuid())

  /// INE `dtmn` code, e.g. "0603" for Coimbra. Stable national identifier, and
  /// what the seed matches on so re-seeding updates rather than duplicates.
  ineCode  String @unique
  name     String
  /// District on the mainland, island in the Azores and Madeira — as INE
  /// scopes them. Free text rather than an enum: it is a label to group by,
  /// carries no behaviour, and the seed is its only writer.
  district String

  latitude  Float
  longitude Float

  localities Locality[]
  hospitals  Hospital[]

  @@unique([name, district])
  @@index([district])
}

/// A freguesia — the granularity Portuguese emergency reporting uses for
/// "where did this happen", and what the UI calls a "localidade".
model Locality {
  id             String       @id @default(cuid())
  name           String
  municipalityId String
  municipality   Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)

  /// `name` folded to lowercase ASCII with punctuation stripped, so a crew
  /// typing "sao martinho" finds "São Martinho do Bispo". Written by the seed
  /// via `foldForSearch` (shared) — never by hand.
  searchName String

  eventReports EventReport[]

  @@unique([municipalityId, name])
  @@index([searchName])
  @@index([municipalityId])
}

// ─── Hospitals ────────────────────────────────────────────────────────────────

/// Somewhere a victim can be taken. Coordinator-managed, the same way holidays
/// are: seeded with a starting set, then maintained in the app.
model Hospital {
  id             String       @id @default(cuid())
  name           String
  municipalityId String
  municipality   Municipality @relation(fields: [municipalityId], references: [id], onDelete: Restrict)

  /// The hospital's own position, when someone has bothered to fill it in.
  /// Null falls back to the municipality centroid, so distance ordering always
  /// works and filling these in only sharpens it.
  latitude  Float?
  longitude Float?

  /// Retired rather than deleted: reports already filed against a hospital
  /// must keep naming it. False hides it from new pickers only.
  isActive Boolean @default(true)

  victims EventReportVictim[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, municipalityId])
  @@index([isActive])
  @@index([municipalityId])
}

// ─── Event Reports ────────────────────────────────────────────────────────────

/// What kind of activity a report accounts for.
///
/// Deliberately the same three kinds as `AvailabilityWindowCategory`: the type
/// is what tells a report which rota its crew came from, so the two sets have
/// to line up. A type is a fixed kind with pre-defined behaviour — never
/// configured per report.
enum EventReportType {
  EMERGENCY
  LOCAL_SUPPORT
  SALOP_SUPPORT
}

/// Where an event happened, as the operational sees it — not an address.
enum EventLocationType {
  HOME
  ROAD
  PUBLIC_SPACE
}

enum Gender {
  FEMALE
  MALE
  UNKNOWN
}

/// What became of one victim.
///
/// `HOSPITAL` is the only value that pairs with a hospital row; the other four
/// are the ways a call ends with nobody transported. A database CHECK
/// constraint (see the migration) keeps the pairing honest, so no query has to
/// defend against "transported to nowhere".
enum VictimDestinationKind {
  HOSPITAL
  TREATED_ON_SCENE
  REFUSED_TRANSPORT
  DECEASED_ON_SCENE
  CANCELLED
}

/// A completed account of one activity: an emergency, a local-support event, or
/// a SALOP support job.
///
/// Identity is `(type, year, number)` — the number is a per-type, per-year
/// sequence, so the three kinds count independently and 2027 starts at 1
/// again. The rendered form ("EMG 128/2026") is *not* stored: it is derived by
/// `formatEventReportCode` in `@redinfo/shared`, which keeps one spelling of
/// the rule and leaves the columns something a report can group by.
///
/// Drafts are not here. An unfinished report lives on the device that is
/// filling it in, because the crew is often out of coverage; a row in this
/// table is a report that was filed.
model EventReport {
  id     String          @id @default(cuid())
  type   EventReportType
  /// Sequence within `(type, year)`, assigned on create. 1-based.
  number Int
  /// Calendar year the sequence belongs to, taken from `occurredOn`. Stored
  /// rather than derived so the unique index below can hold the numbering
  /// rule, and so a year's reports are one index seek away.
  year   Int

  /// The day the activity happened — the date on the paper form. Separate from
  /// `startedAt` because it is what reports group by, and because a service
  /// running past midnight still belongs to the day it started.
  occurredOn DateTime  @db.Date
  startedAt  DateTime
  /// Null while the crew has not said when they finished. A report is filed
  /// with what is known; the rest is completed later.
  endedAt    DateTime?

  /// CODU record number on an emergency, a free reference on the other types.
  /// One column because it is one fact — where it came from is `type`.
  externalReference String?

  locationType EventLocationType
  localityId   String
  /// Restrict, not Cascade: geography is seeded and only ever replaced by a
  /// newer seed. A locality disappearing must not take incident history with it.
  locality     Locality          @relation(fields: [localityId], references: [id], onDelete: Restrict)

  // ── Emergency-only chronology ──
  /// All five are optional, individually: a crew stamps what it has time to
  /// stamp. Present only on EMERGENCY reports — enforced in
  /// `validateEventReport` (shared) rather than by five more CHECK
  /// constraints, since the rule is "these belong to one type" and that is
  /// stated once there.
  activationAt      DateTime?
  sceneArrivalAt    DateTime?
  sceneDepartureAt  DateTime?
  hospitalArrivalAt DateTime?
  availableAt       DateTime?

  /// The shift the crew was pre-filled from, when there was one. Kept so a
  /// coordinator can ask "which rota produced this report" and so future
  /// reporting can join activity back to the schedule that covered it. Null
  /// when the crew was picked by hand — a perfectly ordinary case.
  scheduleId String?
  schedule   Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  /// Which shift of that schedule, as `(date, slot)` — the same coordinates
  /// `ScheduleAssignment` uses. Only meaningful together with `scheduleId`.
  shiftDate  DateTime? @db.Date
  shiftSlot  Int?

  /// TipTap output stored as HTML. Sanitized on write by `sanitizeReportHtml`
  /// and again on render by the frontend viewer — stored markup is trusted at
  /// neither end.
  operationalReport String @db.Text

  crew        EventReportCrewMember[]
  vehicles    EventReportVehicle[]
  victims     EventReportVictim[]
  attachments EventReportAttachment[]

  createdById String
  createdBy   User     @relation("EventReportCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// The numbering rule, as a constraint rather than a convention.
  @@unique([type, year, number])
  @@index([occurredOn])
  @@index([type, occurredOn])
  @@index([localityId])
  @@index([createdById])
  @@index([scheduleId])
}

/// Who was on the activity, and in what post.
///
/// `roleName` is a *snapshot* of the post as it was named on the schedule, not
/// a link to `AvailabilityWindowRole`: roles belong to a window and a
/// coordinator may rename or drop them, which must not rewrite what a filed
/// report says. Null when nobody was assigned a post.
model EventReportCrewMember {
  id       String      @id @default(cuid())
  reportId String
  report   EventReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  userId   String
  /// Restrict: people who leave are deactivated, never deleted, so an archived
  /// report never loses the name of who attended.
  user     User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  roleName String?
  /// Display order within the report, 0-based — the order the crew was entered.
  position Int

  /// One person cannot be on the same activity twice.
  @@unique([reportId, userId])
  @@index([reportId])
  @@index([userId])
}

/// One vehicle used, and the distance it covered.
///
/// A row per vehicle rather than columns on the report: an emergency uses one
/// and a support job may use several, and "sum the kilometres per vehicle per
/// month" should be one GROUP BY, not a union over numbered columns. The
/// one-vehicle rule for emergencies is a validation rule, not a schema one.
model EventReportVehicle {
  id        String      @id @default(cuid())
  reportId  String
  report    EventReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  vehicleId String
  /// Restrict: vehicles are retired via `isDeleted`, never removed.
  vehicle   Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  /// Whole kilometres covered by this vehicle on this activity.
  kilometres Int
  /// Display order within the report, 0-based.
  position   Int

  @@unique([reportId, vehicleId])
  @@index([reportId])
  @@index([vehicleId])
}

/// One person assisted, and where they ended up.
///
/// The destination hangs off the victim rather than the report because a
/// multi-victim event can send people to different places — and an emergency,
/// with its single victim, is then just the one-row case of the same shape.
///
/// No name, no address, no clinical detail: the report records how many people
/// were assisted, roughly who they were, and where they went. Anything more
/// identifying belongs to the clinical record, not here.
model EventReportVictim {
  id       String      @id @default(cuid())
  reportId String
  report   EventReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  /// Display order within the report, 0-based. Also what the UI counts by
  /// ("Vítima 1", "Vítima 2").
  position Int

  gender Gender
  age    Int

  destinationKind       VictimDestinationKind
  /// Set exactly when `destinationKind` is HOSPITAL — a CHECK constraint in
  /// the migration enforces both directions.
  destinationHospitalId String?
  destinationHospital   Hospital?             @relation(fields: [destinationHospitalId], references: [id], onDelete: Restrict)

  @@unique([reportId, position])
  @@index([reportId])
  @@index([destinationHospitalId])
  @@index([destinationKind])
}

/// A photo or document attached to a report.
///
/// Bytes live on disk under the uploads volume, keyed by `storageKey`; only
/// the metadata is in the database. Keeping multi-megabyte photos out of
/// Postgres is what lets the reports table stay cheap to query.
model EventReportAttachment {
  id       String      @id @default(cuid())
  reportId String
  report   EventReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  /// Name as the uploader's device gave it, for display and download only.
  /// Never used to build a path.
  filename   String
  mimeType   String
  byteSize   Int
  /// Path relative to the uploads root, generated server-side. Unique so a
  /// stored file belongs to exactly one row.
  storageKey String @unique

  uploadedById String
  uploadedBy   User     @relation("EventReportAttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())

  @@index([reportId])
  @@index([uploadedById])
}

/// Per-type, per-year report-number sequence — one row per pair, created
/// lazily on first use.
///
/// Postgres's `INSERT ... ON CONFLICT DO UPDATE` (what Prisma's `upsert`
/// compiles to) row-locks for the statement's duration, so concurrent filings
/// for the same type and year serialise on this row and cannot read the same
/// sequence value.
model EventReportCounter {
  type     EventReportType
  year     Int
  sequence Int             @default(0)

  @@id([type, year])
}
