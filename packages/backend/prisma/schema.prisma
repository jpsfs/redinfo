// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SYSTEM_ADMIN
  EMERGENCY_OPERATIONAL
  EMERGENCY_COORDINATOR
  LOGISTICS_COORDINATOR
}

enum AuthProvider {
  LOCAL
  GOOGLE
  MICROSOFT
}

/// The four operational certifications the delegation tracks. DRIVER is
/// autonomous; SBV/TAT/TAS form a ladder — see `UserCertification` and
/// `CERTIFICATION_IMPLIES` in `@redinfo/shared`.
enum CertificationType {
  DRIVER
  SBV
  TAT
  TAS
}

enum BloodType {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  firstName    String
  lastName     String
  passwordHash String?
  role         UserRole     @default(EMERGENCY_OPERATIONAL)
  provider     AuthProvider @default(LOCAL)
  providerId   String?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // ── Personnel profile ──
  // `isDriver` no longer lives here: it is computed from holding a valid
  // DRIVER certification (see `UserCertification`). Everything below is
  // nullable — this is a migration onto rows that never had it.
  phone                 String?
  birthDate             DateTime?  @db.Date
  /// When the person joined the delegation.
  joinedOn              DateTime?  @db.Date
  addressLine           String?
  postalCode            String?
  localityId            String?
  locality              Locality?  @relation(fields: [localityId], references: [id], onDelete: SetNull)
  /// Assigned by the delegation; not self-editable.
  redCrossNumber        String?    @unique
  /// Optional, manually assigned by a coordinator; not self-editable.
  volunteerNumber       String?    @unique
  nif                   String?    @unique
  citizenCardNumber     String?
  bloodType             BloodType?
  emergencyContactName  String?
  emergencyContactPhone String?
  /// The profile photo. Same shape as `UserCertification`'s document — bytes
  /// on disk, metadata here.
  photoFilename         String?
  photoMimeType         String?
  photoByteSize         Int?
  photoStorageKey       String?    @unique
  /// The language the person chose for the UI. NULL means never chosen — the
  /// browser decides, falling back to Portuguese. Do not default this to 'pt':
  /// a default is indistinguishable from a choice, and would break the
  /// browser-language acceptance criterion for every existing row.
  locale                String?    @db.VarChar(2)

  refreshTokens RefreshToken[]

  windowsOpened           AvailabilityWindow[]     @relation("WindowOpenedBy")
  windowsClosed           AvailabilityWindow[]     @relation("WindowClosedBy")
  availabilitySubmissions AvailabilitySubmission[]
  availabilityResponses   AvailabilityResponse[]

  schedulesCreated     Schedule[]              @relation("ScheduleCreatedBy")
  schedulesPublished   Schedule[]              @relation("SchedulePublishedBy")
  scheduleAssignments  ScheduleAssignment[]    @relation("ScheduleAssignedTo")
  assignmentsMade      ScheduleAssignment[]    @relation("ScheduleAssignedBy")
  shiftAdjustmentsMade ScheduleShiftOverride[] @relation("ScheduleShiftAdjustedBy")

  eventReportsCreated    EventReport[]           @relation("EventReportCreatedBy")
  eventReportsSubmitted  EventReport[]           @relation("EventReportSubmittedBy")
  eventReportCrew        EventReportCrewMember[]
  eventReportAttachments EventReportAttachment[] @relation("EventReportAttachmentUploadedBy")

  liveRunsCreated LiveRun[]           @relation("LiveRunCreatedBy")
  liveRunCrew     LiveRunCrewMember[]

  certifications        UserCertification[] @relation("UserCertifications")
  certificationsCreated UserCertification[] @relation("UserCertificationCreatedBy")
  profileAudits         UserProfileAudit[]  @relation("UserProfileAuditSubject")
  profileChangesMade    UserProfileAudit[]  @relation("UserProfileAuditChangedBy")

  volunteerHoursEntries  VolunteerHoursEntry[] @relation("VolunteerHoursOwner")
  volunteerHoursApproved VolunteerHoursEntry[] @relation("VolunteerHoursApprovedBy")
  volunteerHoursLogged   VolunteerHoursEntry[] @relation("VolunteerHoursLoggedBy")
  volunteerHoursReopened VolunteerHoursEntry[] @relation("VolunteerHoursReopenedBy")
  volunteerHoursDeleted  VolunteerHoursEntry[] @relation("VolunteerHoursDeletedBy")

  @@index([email])
  @@index([provider, providerId])
  @@index([isActive, role])
  @@index([localityId])
}

/// A certification actually awarded to a person — see `CertificationType` and
/// `effectiveCertifications` in `@redinfo/shared` for what each one grants.
///
/// Only what was *held* is stored; TAT/SBV granted by a TAS are computed at
/// read time rather than materialised as rows, so there is exactly one place
/// to correct an expiry date.
model UserCertification {
  id     String            @id @default(cuid())
  userId String
  user   User              @relation("UserCertifications", fields: [userId], references: [id], onDelete: Cascade)
  type   CertificationType

  /// Null = no known expiry; counts as valid. What the isDriver→DRIVER
  /// backfill writes, and what a certification looks like before a
  /// coordinator has entered its real date.
  validUntil DateTime? @db.Date
  issuedOn   DateTime? @db.Date
  notes      String?

  /// The scanned certificate. All four null together — a record may exist
  /// before the scan is uploaded.
  filename   String?
  mimeType   String?
  byteSize   Int?
  storageKey String? @unique

  createdById String
  createdBy   User     @relation("UserCertificationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// One record per certification per person — a renewal edits the existing
  /// row rather than adding a second one.
  @@unique([userId, type])
  @@index([userId])
  /// Drives the expiring-soon query.
  @@index([type, validUntil])
}

/// Actor-and-timestamp trail for personnel profile changes, following
/// `VehicleInventoryAudit`'s pattern. For fields marked sensitive (NIF,
/// citizen card, blood type, emergency contact, birth date) `oldValue` and
/// `newValue` stay null — the audit records *that* something changed, not a
/// second copy of the sensitive value.
model UserProfileAudit {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("UserProfileAuditSubject", fields: [userId], references: [id], onDelete: Cascade)
  changedById String
  changedBy   User     @relation("UserProfileAuditChangedBy", fields: [changedById], references: [id], onDelete: Restrict)
  field       String
  oldValue    String?
  newValue    String?
  changedAt   DateTime @default(now())

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
}

enum VehicleType {
  EMERGENCY
  TRANSPORT
}

model Vehicle {
  id                    String      @id @default(cuid())
  licensePlate          String      @unique
  numeroCauda           String      @unique
  vehicleType           VehicleType
  insuranceRenewalDate  DateTime    @db.Date
  nextImtInspectionDate DateTime    @db.Date
  manufacturer          String?
  model                 String?
  notes                 String?
  isDeleted             Boolean     @default(false)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  maintenanceEntries    MaintenanceEntry[]
  vehicleInventoryItems VehicleInventoryItem[]
  stockMovements        StockMovement[]
  eventReports          EventReportVehicle[]
  eventReportMaterials  EventReportMaterial[]
  liveRuns              LiveRun[]

  @@index([vehicleType])
  @@index([isDeleted])
}

model MaintenanceEntry {
  id              String   @id @default(cuid())
  vehicleId       String
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  date            DateTime @db.Date
  description     String
  serviceProvider String
  cost            Decimal  @db.Decimal(10, 2)
  vatAmount       Decimal? @db.Decimal(10, 2)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([vehicleId])
}

// ─── Inventory ────────────────────────────────────────────────────────────────

enum InventoryItemType {
  COUNTABLE
  UNLIMITED
}

/// The catalogue of physical items that can be stocked on a vehicle or
/// consumed during an event report. One `MaterialItem` per real-world item
/// type — replaces the old per-template-item name so the same glove/bandage
/// has a single stable identity across vehicles, barcodes and translations.
model MaterialItem {
  id            String            @id @default(cuid())
  namePt        String
  nameEn        String?
  unit          String            @default("pcs")
  type          InventoryItemType @default(COUNTABLE)
  notes         String?
  isFrequent    Boolean           @default(false)
  frequentOrder Int               @default(0)
  isDeleted     Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  barcodes             MaterialItemBarcode[]
  templateItems        InventoryTemplateItem[]
  stockMovements       StockMovement[]
  eventReportMaterials EventReportMaterial[]

  @@index([isFrequent])
  @@index([isDeleted])
}

/// A barcode (EAN/GS1, etc.) identifying a `MaterialItem`. One item may carry
/// several codes — different manufacturers or box sizes for the same
/// catalogue entry.
model MaterialItemBarcode {
  id             String       @id @default(cuid())
  materialItemId String
  materialItem   MaterialItem @relation(fields: [materialItemId], references: [id], onDelete: Cascade)
  code           String       @unique
  label          String?

  @@index([materialItemId])
}

model InventoryTemplate {
  id          String      @id @default(cuid())
  vehicleType VehicleType @unique
  version     Int         @default(1)
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  items InventoryTemplateItem[]

  @@index([vehicleType])
}

model InventoryTemplateItem {
  id                  String            @id @default(cuid())
  templateId          String
  template            InventoryTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  /// Nullable during the catalogue migration; tightened to required once the
  /// backfill in this same migration has run. `name`/`type`/`unit` below stay
  /// read-through from `materialItem` for now — dropped once every row has
  /// been repointed and callers read through the catalogue instead.
  materialItemId      String?
  materialItem        MaterialItem?     @relation(fields: [materialItemId], references: [id], onDelete: Restrict)
  name                String
  type                InventoryItemType @default(COUNTABLE)
  recommendedQuantity Int?
  unit                String            @default("pcs")
  notes               String?
  order               Int               @default(0)
  isDeleted           Boolean           @default(false)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  vehicleInventoryItems VehicleInventoryItem[]

  @@index([templateId])
  @@index([isDeleted])
  @@index([materialItemId])
}

model VehicleInventoryItem {
  id              String                @id @default(cuid())
  vehicleId       String
  vehicle         Vehicle               @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  templateItemId  String
  templateItem    InventoryTemplateItem @relation(fields: [templateItemId], references: [id], onDelete: Cascade)
  actualQuantity  Int?
  templateVersion Int
  /// Set when a `StockMovement` deduction floored `actualQuantity` at zero,
  /// or when the row was created on the fly for an item a report consumed
  /// that the sheet never knew about. Cleared by a manual recount
  /// (upsert/update/CSV import); never cleared by another consumption.
  needsRecount    Boolean               @default(false)
  updatedById     String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  audits VehicleInventoryAudit[]

  @@unique([vehicleId, templateItemId])
  @@index([vehicleId])
  @@index([templateItemId])
}

model VehicleInventoryAudit {
  id                     String               @id @default(cuid())
  vehicleInventoryItemId String
  vehicleInventoryItem   VehicleInventoryItem @relation(fields: [vehicleInventoryItemId], references: [id], onDelete: Cascade)
  changedById            String?
  oldQuantity            Int?
  newQuantity            Int?
  changedAt              DateTime             @default(now())

  @@index([vehicleInventoryItemId])
}

enum StockMovementReason {
  CONSUMPTION
  MANUAL_ADJUSTMENT
  IMPORT
  CORRECTION
}

/// A single stock delta — the movement ledger behind a vehicle's item count.
/// Replaces before/after auditing as the source of truth for `CONSUMPTION`:
/// a report can be edited or deleted, and its movements need to be found and
/// reversed as a group, which `VehicleInventoryAudit` (keyed off a single
/// `VehicleInventoryItem`, with no report reference) cannot do.
///
/// `delta` is the full amount requested, even when the resulting
/// `VehicleInventoryItem.actualQuantity` floors at zero — the ledger stays
/// truthful about what was spent; the shortfall is a floor plus a
/// `needsRecount` flag, not a rewritten movement. See `StockMovementsService`.
model StockMovement {
  id             String              @id @default(cuid())
  vehicleId      String
  vehicle        Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  materialItemId String
  materialItem   MaterialItem        @relation(fields: [materialItemId], references: [id], onDelete: Restrict)
  delta          Int
  reason         StockMovementReason
  /// The event report this consumption came from — null for manual/import/
  /// correction movements. `SetNull`, not `Cascade`: a report being deleted
  /// has its stock effect explicitly reversed first (see
  /// `StockMovementsService.reverseReportConsumption`); the movement itself
  /// stays as a true historical fact once the report it came from is gone.
  reportId       String?
  report         EventReport?        @relation(fields: [reportId], references: [id], onDelete: SetNull)
  actorId        String?
  occurredAt     DateTime            @default(now())
  note           String?

  @@index([vehicleId, occurredAt])
  @@index([reportId])
}

// ─── Availability ─────────────────────────────────────────────────────────────

enum AvailabilityWindowStatus {
  OPEN
  CLOSED
}

/// Independent rotas. Two windows may cover the same dates as long as their
/// categories differ; within one category only one open window may cover a day.
enum AvailabilityWindowCategory {
  EMERGENCY
  LOCAL_SUPPORT
  SALOP_SUPPORT
}

/// Only DECLINED is ever stored: absence of a row means "not yet responded".
enum AvailabilityResponseStatus {
  DECLINED
}

/// Coordinator-maintained holiday table (no external API). A holiday makes a
/// weekday follow the weekend shift pattern.
model Holiday {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

model AvailabilityWindow {
  id         String                     @id @default(cuid())
  startDate  DateTime                   @db.Date
  endDate    DateTime                   @db.Date
  /// Which rota this window collects availability for. No default on purpose:
  /// every caller states it, so a missing category cannot silently become one.
  category   AvailabilityWindowCategory
  /// Optional free-text title, e.g. "Emergency - October". Not unique.
  name       String?
  status     AvailabilityWindowStatus   @default(OPEN)
  openedById String
  openedBy   User                       @relation("WindowOpenedBy", fields: [openedById], references: [id])
  openedAt   DateTime                   @default(now())
  closedById String?
  closedBy   User?                      @relation("WindowClosedBy", fields: [closedById], references: [id])
  closedAt   DateTime?
  createdAt  DateTime                   @default(now())
  updatedAt  DateTime                   @updatedAt

  submissions AvailabilitySubmission[]
  responses   AvailabilityResponse[]
  shifts      AvailabilityWindowShift[]
  roles       AvailabilityWindowRole[]
  schedule    Schedule?

  @@index([status])
  @@index([startDate, endDate])
  /// Overlap checks are always "this category, these dates".
  @@index([category, status])
}

/// The shifts of one day of one window, materialised when the window is opened.
///
/// Windows carry their own grid rather than deriving it: a coordinator may give
/// any day any times, and a holiday added after the fact must not silently
/// invalidate submissions already made against the day it lands on.
model AvailabilityWindowShift {
  id             String             @id @default(cuid())
  windowId       String
  window         AvailabilityWindow @relation(fields: [windowId], references: [id], onDelete: Cascade)
  date           DateTime           @db.Date
  /// 1-based position within the day, ordered by startMinute. Submissions point here.
  slot           Int
  /// Minutes from midnight the shift starts, 0–1439.
  startMinute    Int
  /// Minutes from midnight it ends, 1–1440 (1440 = midnight).
  endMinute      Int
  /// Vehicles to be crewed on this shift; each needs its own driver, which is
  /// what the coverage colours are judged against. 0 = people only.
  vehiclesNeeded Int

  @@unique([windowId, date, slot])
  @@index([windowId])
}

/// A post the schedule for this window assigns people to.
///
/// Roles hang off the window rather than off a person or a shift: availability
/// is collected without them (a volunteer says only when they can be there) and
/// the coordinator allocates roles when building the schedule.
model AvailabilityWindowRole {
  id                    String             @id @default(cuid())
  windowId              String
  window                AvailabilityWindow @relation(fields: [windowId], references: [id], onDelete: Cascade)
  name                  String
  /// Most people the schedule may put in this role on one shift. 0 = unlimited.
  maxPeople             Int
  /// Fewest people this post needs filled for the shift to count as properly
  /// crewed — 0 for a role that is a "pool" seat rather than a required post
  /// (a Team Member can fill it, or not, or leave mid-shift, without that
  /// blocking anything). Never more than `maxPeople` unless `maxPeople` is the
  /// unlimited sentinel (`0`), in which case a positive count still means "at
  /// least this many", with no cap. Read by volunteer-hours generation
  /// (`#164`) to decide whether a shift's default hours may be auto-created;
  /// unrelated to `shiftGaps()`, which still judges every finite role against
  /// its `maxPeople` for the schedule board's own gap chips.
  mandatoryCount        Int                @default(0)
  /// The certification someone must hold to be assigned here, or null for no
  /// requirement. A coordinator's choice — the editor suggests DRIVER for a
  /// role named "Driver", but nothing forces it, and every requirement is
  /// overridable at assignment time with a recorded reason.
  requiredCertification CertificationType?
  /// Position in the window's own role list, 0-based.
  order                 Int

  assignments ScheduleAssignment[]

  /// One post per name: two roles a schedule cannot tell apart are not two roles.
  @@unique([windowId, name])
  @@index([windowId])
}

model AvailabilitySubmission {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  windowId  String
  window    AvailabilityWindow @relation(fields: [windowId], references: [id], onDelete: Cascade)
  date      DateTime           @db.Date
  /// Slot of AvailabilityWindowShift for the same (windowId, date). Not a
  /// foreign key: the shift row is identified by a composite the submission
  /// would otherwise have to duplicate, and slots never move once opened.
  slot      Int
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([windowId, userId, date, slot])
  @@index([windowId])
  @@index([date])
  @@index([userId])
}

enum ScheduleStatus {
  DRAFT
  PUBLISHED
}

/// The duty roster built from one availability window.
///
/// One per window, and identified by it: windows of different categories may
/// cover the same dates, so there is no single "monthly schedule" to hang this
/// off. A schedule may be started while its window is still open — coordinators
/// begin arranging cover before submissions close.
model Schedule {
  id            String             @id @default(cuid())
  windowId      String             @unique
  window        AvailabilityWindow @relation(fields: [windowId], references: [id], onDelete: Cascade)
  status        ScheduleStatus     @default(DRAFT)
  createdById   String
  createdBy     User               @relation("ScheduleCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime           @default(now())
  publishedById String?
  publishedBy   User?              @relation("SchedulePublishedBy", fields: [publishedById], references: [id])
  publishedAt   DateTime?
  updatedAt     DateTime           @updatedAt

  assignments    ScheduleAssignment[]
  /// Reports whose crew was pre-filled from a shift of this schedule.
  eventReports   EventReport[]
  /// Runs in progress whose crew came from a shift of this schedule.
  liveRuns       LiveRun[]
  shiftOverrides ScheduleShiftOverride[]
  /// Volunteer-hours entries generated from this schedule's assignments.
  volunteerHoursEntries VolunteerHoursEntry[]

  @@index([status])
}

/// One person on one shift of one schedule, in at most one role.
model ScheduleAssignment {
  id                          String                  @id @default(cuid())
  scheduleId                  String
  schedule                    Schedule                @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  /// Identified the same way a submission is — by (date, slot) rather than a
  /// foreign key to the shift row. Slots never move once a window is opened, and
  /// this keeps a legacy window with no materialised shifts schedulable.
  date                        DateTime                @db.Date
  slot                        Int
  userId                      String
  user                        User                    @relation("ScheduleAssignedTo", fields: [userId], references: [id], onDelete: Cascade)
  /// Null only when the window defines no roles at all.
  roleId                      String?
  role                        AvailabilityWindowRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)
  /// The person had not submitted availability for this shift when they were
  /// assigned. Computed server-side and never recomputed afterwards: it records
  /// a decision, so a later change of availability must not rewrite history.
  isOverride                  Boolean                 @default(false)
  /// Set when this assignment was made against the post's own
  /// `requiredCertification` — non-null exactly when a reason was given.
  /// Distinct from `isOverride`, which is about availability, not
  /// certification: an assignment may carry either, both, or neither.
  certificationOverrideReason String?
  assignedById                String
  assignedBy                  User                    @relation("ScheduleAssignedBy", fields: [assignedById], references: [id])
  assignedAt                  DateTime                @default(now())

  /// The volunteer-hours entry generated from this assignment, if any. Not
  /// every assignment has one yet — generation is lazy, on read (#164).
  volunteerHoursEntry VolunteerHoursEntry?

  /// One person at most once per shift — the same person in two roles on one
  /// shift is a data error, not a conflict to report.
  @@unique([scheduleId, date, slot, userId])
  @@index([scheduleId])
  @@index([userId, date])
  @@index([date])
}

/// A coordinator's correction to one shift's hours, for one schedule alone.
///
/// The availability window's own `AvailabilityWindowShift` is never edited
/// after opening — it is the record of what people were asked about, and
/// submissions were made against it. Reality sometimes differs from the
/// pattern once the schedule is being built (a shift genuinely starts an hour
/// early, or runs late), and this is where that correction lives: keyed the
/// same way an assignment is, by `(scheduleId, date, slot)` rather than a
/// foreign key to the shift row, so it works even for a legacy window whose
/// shifts are derived rather than materialised.
///
/// Carries no `vehiclesNeeded` — only clock times move here, so coverage
/// maths and list-page fill stats never need to look at this table at all.
model ScheduleShiftOverride {
  id           String   @id @default(cuid())
  scheduleId   String
  schedule     Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  date         DateTime @db.Date
  slot         Int
  /// Minutes from midnight the shift now starts, 0–1439.
  startMinute  Int
  /// Minutes from midnight it now ends, 1–1440 (1440 = midnight).
  endMinute    Int
  adjustedById String
  adjustedBy   User     @relation("ScheduleShiftAdjustedBy", fields: [adjustedById], references: [id])
  adjustedAt   DateTime @default(now())

  @@unique([scheduleId, date, slot])
  @@index([scheduleId])
}

/// Tri-state response tracking: "submitted" is derived from
/// AvailabilitySubmission rows existing, "declined" needs its own record since
/// row-absence alone cannot tell it apart from "not yet responded".
model AvailabilityResponse {
  id          String                     @id @default(cuid())
  windowId    String
  window      AvailabilityWindow         @relation(fields: [windowId], references: [id], onDelete: Cascade)
  userId      String
  user        User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      AvailabilityResponseStatus @default(DECLINED)
  respondedAt DateTime                   @default(now())

  @@unique([windowId, userId])
  @@index([windowId])
}

// ─── Volunteer hours ────────────────────────────────────────────────────────────

/// Where an entry's default came from. A `SCHEDULED` entry is proposed by the
/// system from a `ScheduleAssignment`; a `MANUAL` one has no shift behind it
/// at all (a meeting, training, or anything else a volunteer logs by hand)
/// and always needs a coordinator's eyes — there is nothing to auto-validate
/// it against.
enum VolunteerHoursSource {
  SCHEDULED
  MANUAL
}

/// What the hours were for. The rota categories double as activity types for
/// `SCHEDULED` entries (one per `AvailabilityWindowCategory`); the other
/// three exist only for `MANUAL` entries.
enum VolunteerActivityType {
  EMERGENCY
  LOCAL_SUPPORT
  SALOP_SUPPORT
  MEETING
  TRAINING
  OTHER
}

/// Two states, not four: an entry is either still waiting on someone (a
/// coordinator, or the grace-period sweep), or it counts. There is no
/// separate "rejected" — disputing a `MANUAL` entry or a `SCHEDULED` one that
/// overclaims is done by approving it with `minutes` corrected down (to zero,
/// if nothing should count at all) and a `correctionReason`.
enum VolunteerHoursStatus {
  PENDING
  APPROVED
}

/// One volunteer's credited time for one activity — either derived from a
/// shift they were scheduled on, or logged by hand for something that never
/// had one (#164).
///
/// Generation is lazy (on read), not a timer sweep: a `SCHEDULED` entry is
/// materialised the first time anything asks about a past assignment, which
/// means "does this entry exist yet" is never itself a correctness question
/// (see `identity-purge.service.ts` for the same argument made about a
/// different cleanup job).
model VolunteerHoursEntry {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("VolunteerHoursOwner", fields: [userId], references: [id], onDelete: Cascade)

  source       VolunteerHoursSource
  activityType VolunteerActivityType

  /// The assignment this was generated from. Null for a MANUAL entry, and
  /// SetNull rather than Cascade when the assignment itself is later removed
  /// — unassigning someone must not erase an approval already on record, only
  /// the live link back to the roster.
  assignmentId String?              @unique
  assignment   ScheduleAssignment?  @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  /// Denormalised alongside `assignmentId` so the schedule this came from is
  /// still known after the assignment link itself is gone.
  scheduleId   String?
  schedule     Schedule?            @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  /// The shift's own date for a SCHEDULED entry, or the date logged for a
  /// MANUAL one. Drives grace-period timing and every aggregation view.
  date         DateTime             @db.Date

  /// Optional free text for a MANUAL entry (what the meeting/training/other
  /// activity was) — required only when activityType is OTHER; unused for
  /// SCHEDULED, where the shift itself is the description.
  description String? @db.Text

  /// The shift's own duration in minutes, snapshotted at generation time so a
  /// later `ScheduleShiftOverride` never silently rewrites an entry already
  /// reviewed. Null for MANUAL, which has no shift to snapshot.
  baselineMinutes Int?
  /// What the system proposes crediting: `baselineMinutes` plus any
  /// auto-credited run-over for SCHEDULED, or exactly what the volunteer
  /// typed for MANUAL.
  proposedMinutes Int
  /// What actually counts towards totals. Equal to `proposedMinutes` until a
  /// coordinator corrects it.
  minutes Int

  /// Exception codes raised by detection — e.g. `RAN_OVER`,
  /// `POSSIBLY_LEFT_EARLY`. Always empty for MANUAL, and for a SCHEDULED
  /// entry with nothing to flag. Never generated at all for a shift whose
  /// mandatory roles were not filled — that shift most likely did not run, so
  /// there is nothing to flag rather than something to credit and flag.
  flags       String[] @default([])
  /// Evidence behind each flag (which report, how many minutes over, …), read
  /// only by the review screen — nothing queries into it, so it is one block
  /// rather than a child table.
  flagDetails Json?

  status       VolunteerHoursStatus @default(PENDING)
  approvedById String?
  approvedBy   User?                @relation("VolunteerHoursApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  /// True when PENDING became APPROVED through the grace-period sweep rather
  /// than a person's own action. Never true for MANUAL, or once corrected.
  autoApproved     Boolean @default(false)
  /// Present exactly when `minutes` differs from `proposedMinutes`.
  correctionReason String?

  /// Who logged this, for a MANUAL entry — null for SCHEDULED, which nobody
  /// files by hand.
  loggedById String?
  loggedBy   User?    @relation("VolunteerHoursLoggedBy", fields: [loggedById], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  /// Set when a coordinator sent an APPROVED entry back to PENDING. Read by
  /// `isEligibleForAutoApproval` so the grace-period sweep never re-approves
  /// something a person deliberately reopened.
  reopenedAt   DateTime?
  reopenedById String?
  reopenedBy   User?     @relation("VolunteerHoursReopenedBy", fields: [reopenedById], references: [id])

  /// Soft delete. The row is retained rather than removed because
  /// `ensureGenerated` treats an assignment with no entry as one still to
  /// generate — hard-deleting a SCHEDULED entry would resurrect it on the very
  /// next read of any hours endpoint.
  deletedAt      DateTime?
  deletedById    String?
  deletedBy      User?     @relation("VolunteerHoursDeletedBy", fields: [deletedById], references: [id])
  deletionReason String?   @db.Text

  @@index([userId, date])
  @@index([status])
  @@index([scheduleId])
  @@index([date])
  @@index([status, date])
  @@index([deletedAt])
}

// ─── Geography ────────────────────────────────────────────────────────────────

/// A Portuguese municipality (concelho).
///
/// Seeded from `prisma/data/pt-localities.json` (regenerated by
/// `scripts/fetch-pt-localities.mjs`) and never edited in the app: the
/// administrative map is not ours to change.
///
/// The coordinate lives here rather than on `Locality` because its only job is
/// ordering hospitals by distance from where an event happened. Hospitals are
/// tens of kilometres apart and a municipality is a few across, so one
/// coordinate per municipality is precise enough for that ordering — and keeps
/// 3,259 freguesias from each carrying a number nothing reads.
model Municipality {
  id String @id @default(cuid())

  /// INE `dtmn` code, e.g. "0603" for Coimbra. Stable national identifier, and
  /// what the seed matches on so re-seeding updates rather than duplicates.
  ineCode  String @unique
  name     String
  /// District on the mainland, island in the Azores and Madeira — as INE
  /// scopes them. Free text rather than an enum: it is a label to group by,
  /// carries no behaviour, and the seed is its only writer.
  district String

  latitude  Float
  longitude Float

  localities Locality[]
  hospitals  Hospital[]

  @@unique([name, district])
  @@index([district])
}

/// A freguesia — the granularity Portuguese emergency reporting uses for
/// "where did this happen", and what the UI calls a "localidade".
model Locality {
  id             String       @id @default(cuid())
  name           String
  municipalityId String
  municipality   Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)

  /// `name` folded to lowercase ASCII with punctuation stripped, so a crew
  /// typing "sao martinho" finds "São Martinho do Bispo". Written by the seed
  /// via `foldForSearch` (shared) — never by hand.
  searchName String

  eventReports EventReport[]
  liveRuns     LiveRun[]
  users        User[]

  @@unique([municipalityId, name])
  @@index([searchName])
  @@index([municipalityId])
}

// ─── Hospitals ────────────────────────────────────────────────────────────────

/// Somewhere a victim can be taken. Coordinator-managed, the same way holidays
/// are: seeded with a starting set, then maintained in the app.
model Hospital {
  id             String       @id @default(cuid())
  name           String
  municipalityId String
  municipality   Municipality @relation(fields: [municipalityId], references: [id], onDelete: Restrict)

  /// The hospital's own position, when someone has bothered to fill it in.
  /// Null falls back to the municipality centroid, so distance ordering always
  /// works and filling these in only sharpens it.
  latitude  Float?
  longitude Float?

  /// Retired rather than deleted: reports already filed against a hospital
  /// must keep naming it. False hides it from new pickers only.
  isActive Boolean @default(true)

  victims          EventReportVictim[]
  inemSupportUnits EventReportInemSupportUnit[]
  liveRuns         LiveRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, municipalityId])
  @@index([isActive])
  @@index([municipalityId])
}

// ─── Event Reports ────────────────────────────────────────────────────────────

/// What kind of activity a report accounts for.
///
/// Deliberately the same three kinds as `AvailabilityWindowCategory`: the type
/// is what tells a report which rota its crew came from, so the two sets have
/// to line up. A type is a fixed kind with pre-defined behaviour — never
/// configured per report.
enum EventReportType {
  EMERGENCY
  LOCAL_SUPPORT
  SALOP_SUPPORT
}

/// Where an event happened, as the operational sees it — not an address.
enum EventLocationType {
  HOME
  ROAD
  PUBLIC_SPACE
  OTHER_PUBLIC_LOCATION
  WORK_PLACE
}

enum Gender {
  FEMALE
  MALE
  UNKNOWN
}

/// What became of one victim.
///
/// `HOSPITAL` is the only value that pairs with a hospital row; the other four
/// are the ways a call ends with nobody transported. A database CHECK
/// constraint (see the migration) keeps the pairing honest, so no query has to
/// defend against "transported to nowhere".
enum VictimDestinationKind {
  HOSPITAL
  TREATED_ON_SCENE
  REFUSED_TRANSPORT
  DECEASED_ON_SCENE
  CANCELLED
}

/// Additional INEM means that responded alongside the crew's own vehicle.
enum InemSupportUnitType {
  VMER
  SIV
  UMIP
}

/// A completed account of one activity: an emergency, a local-support event, or
/// a SALOP support job.
///
/// Identity is `(type, year, number)` — the number is a per-type, per-year
/// sequence, so the three kinds count independently and 2027 starts at 1
/// again. The rendered form ("EMG 128/2026") is *not* stored: it is derived by
/// `formatEventReportCode` in `@redinfo/shared`, which keeps one spelling of
/// the rule and leaves the columns something a report can group by.
///
/// Drafts *are* here, since live mode (ADO #154). A run that closes becomes a
/// draft report immediately — a row whose `submittedAt` is null — so a crew that
/// forgets the paperwork still leaves something visible behind. The device is
/// still where a run in progress lives; this table takes over the moment the
/// ambulance is available again.
model EventReport {
  id           String          @id @default(cuid())
  type         EventReportType
  /// Position within `(type, year)`, 1-based, assigned when the report is
  /// **submitted** and recomputed whenever the partition changes. Null while
  /// the report is a draft: a report with no number is a report nobody has
  /// filed yet, and Postgres treats NULLs as distinct so the unique constraint
  /// stays quiet about drafts.
  number       Int?
  /// What this report was called before the sequence was last recomputed. Kept
  /// forever and searchable, so paper filed as "EMG 042/2026" stays findable
  /// after a renumber.
  legacyNumber Int?
  /// Calendar year the sequence belongs to, taken from `occurredOn`. Stored
  /// rather than derived so the unique index below can hold the numbering
  /// rule, and so a year's reports are one index seek away.
  year         Int

  /// Who filed it and when. An actor-and-timestamp pair rather than a boolean,
  /// matching `Schedule.publishedBy/publishedAt`: a transition is a fact about a
  /// person and a moment. `submittedAt IS NULL` *is* the draft state — there is
  /// no status enum to disagree with it, and no `unsubmit`, because un-filing a
  /// report would re-punch the hole in the numbering.
  submittedAt   DateTime?
  submittedById String?
  submittedBy   User?     @relation("EventReportSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)

  /// The day the activity happened — the date on the paper form. Separate from
  /// `startedAt` because it is what reports group by, and because a service
  /// running past midnight still belongs to the day it started.
  occurredOn DateTime  @db.Date
  startedAt  DateTime
  /// Null while the crew has not said when they finished. A report is filed
  /// with what is known; the rest is completed later.
  endedAt    DateTime?

  /// CODU record number on an emergency, a free reference on the other types.
  /// One column because it is one fact — where it came from is `type`.
  externalReference String?

  locationType EventLocationType
  localityId   String
  /// Restrict, not Cascade: geography is seeded and only ever replaced by a
  /// newer seed. A locality disappearing must not take incident history with it.
  locality     Locality          @relation(fields: [localityId], references: [id], onDelete: Restrict)

  // ── Emergency-only chronology ──
  /// All five are optional, individually: a crew stamps what it has time to
  /// stamp. Present only on EMERGENCY reports — enforced in
  /// `validateEventReport` (shared) rather than by five more CHECK
  /// constraints, since the rule is "these belong to one type" and that is
  /// stated once there.
  activationAt      DateTime?
  sceneArrivalAt    DateTime?
  sceneDepartureAt  DateTime?
  hospitalArrivalAt DateTime?
  availableAt       DateTime?

  /// The shift the crew was pre-filled from, when there was one. Kept so a
  /// coordinator can ask "which rota produced this report" and so future
  /// reporting can join activity back to the schedule that covered it. Null
  /// when the crew was picked by hand — a perfectly ordinary case.
  scheduleId String?
  schedule   Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  /// Which shift of that schedule, as `(date, slot)` — the same coordinates
  /// `ScheduleAssignment` uses. Only meaningful together with `scheduleId`.
  shiftDate  DateTime? @db.Date
  shiftSlot  Int?

  /// TipTap output stored as HTML. Sanitized on write by `sanitizeReportHtml`
  /// and again on render by the frontend viewer — stored markup is trusted at
  /// neither end.
  operationalReport String @db.Text

  // ── The clinical record (emergencies only) ──
  /// CHAMU, as five columns rather than one JSON blob: the set is fixed by a
  /// national form, each is shown as its own labelled field, and a blob would
  /// make "which reports mention an allergy" unanswerable for no gain.
  ///
  /// These carry no names — the screens say "sem nomes" on the fields — but they
  /// are free text a crew types, so they are treated as clinical data rather
  /// than as safe.
  chamuCircumstances String? @db.Text
  chamuHistory       String? @db.Text
  chamuAllergies     String? @db.Text
  chamuMedication    String? @db.Text
  chamuLastMeal      String? @db.Text

  /// Five optional `{ status, note }` pairs. JSON *because nothing queries a
  /// letter*: it is read as one block, written as one block, and its shape is
  /// INEM's to change rather than ours.
  abcde Json?

  crew             EventReportCrewMember[]
  vehicles         EventReportVehicle[]
  victims          EventReportVictim[]
  inemSupportUnits EventReportInemSupportUnit[]
  materials        EventReportMaterial[]
  attachments      EventReportAttachment[]
  assessments      EventReportAssessment[]
  stockMovements   StockMovement[]

  /// The run this report was closed out of, if there was one. The run owns the
  /// link, so this side is read-only provenance.
  liveRun LiveRun?

  createdById String
  createdBy   User     @relation("EventReportCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// The numbering rule, as a constraint rather than a convention.
  ///
  /// The migration replaces the index Prisma would create with a same-named
  /// **DEFERRABLE** unique constraint: shifting a whole partition along by one
  /// transiently collides with itself, and a row-by-row check would reject the
  /// UPDATE halfway through. Deferrability is not something Prisma models, so
  /// this line and the database still agree.
  @@unique([type, year, number])
  @@index([occurredOn])
  @@index([type, occurredOn])
  @@index([localityId])
  @@index([createdById])
  @@index([scheduleId])
  /// Numbering reads a whole `(type, year)` partition in activation order.
  @@index([type, year, activationAt])
  /// The *Pendentes* grouping, and the purge's "has this been filed yet".
  @@index([submittedAt])
  @@index([type, year, legacyNumber])
}

/// One set of observations, taken at one moment.
///
/// A child table because a set of vitals is something taken *at a time*:
/// usually once on scene, but a deteriorating victim is measured again on the
/// way in, and "what were the vitals when they left" must not overwrite "what
/// were they when we arrived".
///
/// Every measurement is individually optional and each has a CHECK for its own
/// plausible-instrument range (see the migration). Two are worth naming:
/// `heartRate` allows **0**, because asystole is a real recordable finding
/// rather than a missing value, and a row with nothing measured in it at all is
/// refused — an assessment with no measurement is not an assessment.
model EventReportAssessment {
  id       String      @id @default(cuid())
  reportId String
  report   EventReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  /// Display order within the report, 0-based — the order they were taken.
  position Int
  takenAt  DateTime

  /// mg/dL
  bloodGlucose    Int?
  /// mmHg
  systolic        Int?
  diastolic       Int?
  /// °C. Decimal rather than Float, following `MaintenanceEntry.cost`: 36.8 is
  /// a number, not a float to be surprised by.
  temperature     Decimal? @db.Decimal(3, 1)
  /// bpm
  heartRate       Int?
  /// cpm
  respiratoryRate Int?
  /// %
  spo2            Int?
  /// 3–15
  glasgow         Int?
  /// 0–10
  painScore       Int?

  /// How the victim was found or placed. Named `bodyPosition` because
  /// `position` above already means display order in every sibling table.
  bodyPosition String?

  @@unique([reportId, position])
  @@index([reportId])
}

/// Who was on the activity, and in what post.
///
/// `roleName` is a *snapshot* of the post as it was named on the schedule, not
/// a link to `AvailabilityWindowRole`: roles belong to a window and a
/// coordinator may rename or drop them, which must not rewrite what a filed
/// report says. Null when nobody was assigned a post.
model EventReportCrewMember {
  id       String      @id @default(cuid())
  reportId String
  report   EventReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  userId   String
  /// Restrict: people who leave are deactivated, never deleted, so an archived
  /// report never loses the name of who attended.
  user     User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  roleName String?
  /// Display order within the report, 0-based — the order the crew was entered.
  position Int

  /// One person cannot be on the same activity twice.
  @@unique([reportId, userId])
  @@index([reportId])
  @@index([userId])
}

/// One vehicle used, and the distance it covered.
///
/// A row per vehicle rather than columns on the report: an emergency uses one
/// and a support job may use several, and "sum the kilometres per vehicle per
/// month" should be one GROUP BY, not a union over numbered columns. The
/// one-vehicle rule for emergencies is a validation rule, not a schema one.
model EventReportVehicle {
  id        String      @id @default(cuid())
  reportId  String
  report    EventReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  vehicleId String
  /// Restrict: vehicles are retired via `isDeleted`, never removed.
  vehicle   Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  /// Whole kilometres covered by this vehicle on this activity.
  kilometres Int
  /// Display order within the report, 0-based.
  position   Int

  /// The legs `kilometres` was computed from — Base → occurrence → hospital →
  /// Base — as returned by the Google Routes API. Stored so "28 km" is
  /// explainable a year later rather than being a number with no provenance.
  /// Null on a report whose distance was typed, or not computed yet.
  routeLegs    Json?
  /// A human changed the computed figure. Kept so an edited number is visibly
  /// an edit rather than silently replacing a measurement.
  isOverridden Boolean @default(false)

  @@unique([reportId, vehicleId])
  @@index([reportId])
  @@index([vehicleId])
}

/// One item consumed on the activity, and by which vehicle — the report's
/// material consumption line. `quantity` is null only for an `UNLIMITED`
/// item: logged as used, with nothing to count and no stock effect. Stock
/// itself only moves when the report is submitted — see
/// `StockMovementsService.applyReportConsumption`.
model EventReportMaterial {
  id       String      @id @default(cuid())
  reportId String
  report   EventReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  materialItemId String
  /// Restrict: a filed report's line must not lose what it points at.
  materialItem   MaterialItem @relation(fields: [materialItemId], references: [id], onDelete: Restrict)
  vehicleId      String
  /// Restrict, matching `EventReportVehicle`: a vehicle is retired via
  /// `isDeleted`, never removed.
  vehicle        Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  quantity Int?
  /// Display order within the report, 0-based.
  position Int

  /// One line per item per vehicle — using the same item on two vehicles on
  /// one report is two lines, not a merge.
  @@unique([reportId, materialItemId, vehicleId])
  @@index([reportId])
  @@index([materialItemId])
  @@index([vehicleId])
}

/// One person assisted, and where they ended up.
///
/// The destination hangs off the victim rather than the report because a
/// multi-victim event can send people to different places — and an emergency,
/// with its single victim, is then just the one-row case of the same shape.
///
/// No name, no address, no clinical detail: the report records how many people
/// were assisted, roughly who they were, and where they went. Anything more
/// identifying belongs to the clinical record, not here.
model EventReportVictim {
  id       String      @id @default(cuid())
  reportId String
  report   EventReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  /// Display order within the report, 0-based. Also what the UI counts by
  /// ("Vítima 1", "Vítima 2").
  position Int

  gender Gender
  age    Int

  destinationKind       VictimDestinationKind
  /// Set exactly when `destinationKind` is HOSPITAL — a CHECK constraint in
  /// the migration enforces both directions.
  destinationHospitalId String?
  destinationHospital   Hospital?             @relation(fields: [destinationHospitalId], references: [id], onDelete: Restrict)

  @@unique([reportId, position])
  @@index([reportId])
  @@index([destinationHospitalId])
  @@index([destinationKind])
}

/// One VMER, SIV or UMIP that responded alongside the crew's own vehicle, and
/// the base it was dispatched from — captured only on emergencies (see
/// `EventReportTypeRules.hasInemSupportUnits` in `@redinfo/shared`), and only
/// in the report editor, after the fact.
///
/// Neither the per-type cap of 3 nor the "emergency only" rule is a database
/// constraint: the cap is an aggregate over sibling rows and "emergency only"
/// would need this row to know its parent's `type`, so both stay in
/// `validateInemSupportUnits` (shared), same call as `EventReportAssessment`'s
/// range checks. `hospitalId` being required and FK'd is the one rule the
/// schema *can* express.
model EventReportInemSupportUnit {
  id       String      @id @default(cuid())
  reportId String
  report   EventReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  unitType InemSupportUnitType

  /// The base the unit was dispatched from — not a destination. Restrict, not
  /// Cascade: a hospital is retired via `isActive`, never deleted, so a filed
  /// report never loses the name of it.
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)

  /// Display order within the report, 0-based. Not unique per `(reportId,
  /// unitType)` — two VMER from different bases on the same report is exactly
  /// the case this table exists for.
  position Int

  @@unique([reportId, position])
  @@index([reportId])
  @@index([hospitalId])
  @@index([unitType])
}

/// A photo or document attached to a report.
///
/// Bytes live on disk under the uploads volume, keyed by `storageKey`; only
/// the metadata is in the database. Keeping multi-megabyte photos out of
/// Postgres is what lets the reports table stay cheap to query.
model EventReportAttachment {
  id       String      @id @default(cuid())
  reportId String
  report   EventReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  /// What the file *is*, as distinct from what it contains. A discriminator
  /// rather than a second table: the bytes, the MIME allow-list, the size cap,
  /// the storage keys and the download route are all identical. A partial unique
  /// index (see the migration) holds "at most one Verbete per report"; the
  /// service refuses the second one first, with a message worth reading.
  kind EventReportAttachmentKind @default(GENERAL)

  /// Name as the uploader's device gave it, for display and download only.
  /// Never used to build a path.
  filename   String
  mimeType   String
  byteSize   Int
  /// Path relative to the uploads root, generated server-side. Unique so a
  /// stored file belongs to exactly one row.
  storageKey String @unique

  uploadedById String
  uploadedBy   User     @relation("EventReportAttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())

  @@index([reportId])
  @@index([uploadedById])
}

/// What an attachment *is*. See `EventReportAttachment.kind`.
enum EventReportAttachmentKind {
  /// The paper INEM *Verbete de Socorro*. At most one per report.
  VERBETE
  /// Photographs taken on scene, and anything else.
  GENERAL
}

// ─── Live emergency runs ──────────────────────────────────────────────────────

/// Where a run has got to. `CLOSED` is reachable from every stage — a call can
/// be stood down at any point. Which stamp each transition writes lives in
/// `LIVE_RUN_STATE_RULES` in `@redinfo/shared`, not in a chain here, following
/// the `EVENT_REPORT_TYPE_RULES` pattern.
enum LiveRunState {
  INTAKE
  EN_ROUTE
  ON_SCENE
  EN_ROUTE_TO_HOSPITAL
  AT_HOSPITAL
  CLOSED
}

/// The server's mirror of what one phone is capturing during an emergency.
///
/// **The device is the source of truth.** This row exists so a dead phone, a
/// lost phone or a back-to-back call loses nothing, and so a coordinator can see
/// what is running. `PUT /live-runs/:id` is an idempotent whole-row replace
/// guarded by the device-owned `revision`; a PUT at or below the stored revision
/// is a stale replay from a phone that has been in a cellar, and is answered 200
/// with the stored row rather than 409.
///
/// `id` has **no** `@default(cuid())` on purpose: the client owns it, so a run
/// created with no coverage syncs an hour later into the row it would have
/// created at the time.
model LiveRun {
  id       String       @id
  revision Int          @default(0)
  state    LiveRunState @default(INTAKE)

  /// When the crew opened the screen — before activation, while still on the
  /// call from CODU.
  startedAt DateTime

  // ── Plaintext: everything the coordinator's board sorts, filters or counts ──
  externalReference String?
  /// The reason for the call as CODU gave it, e.g. "queda com traumatismo".
  chiefComplaint    String?
  locationType      EventLocationType?
  localityId        String?
  locality          Locality?          @relation(fields: [localityId], references: [id], onDelete: Restrict)
  victimGender      Gender?
  victimAge         Int?
  vehicleId         String?
  vehicle           Vehicle?           @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  scheduleId String?
  schedule   Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  shiftDate  DateTime? @db.Date
  shiftSlot  Int?

  activationAt      DateTime?
  sceneArrivalAt    DateTime?
  sceneDepartureAt  DateTime?
  hospitalArrivalAt DateTime?
  availableAt       DateTime?

  destinationKind       VictimDestinationKind?
  destinationHospitalId String?
  destinationHospital   Hospital?              @relation(fields: [destinationHospitalId], references: [id], onDelete: Restrict)

  /// Vitals, CHAMU, ABCDE and the narrative in progress. JSON because this is a
  /// *mirror, not a model*: the server never edits a field of it, it replaces
  /// the whole thing. Columns would mean migrating this table every time the
  /// phone's form gains a box.
  capture Json?

  /// One AES-256-GCM blob: victim name, date of birth, SNS number, occurrence
  /// address, reference points, home address. Sealed with the run id as
  /// additional authenticated data, so copying row A's blob into row B fails to
  /// open — which matters here more than usual, because rows are keyed by
  /// client-supplied ids.
  identity         Bytes?
  /// Set when the blob was destroyed, so "we never had it" and "we had it and it
  /// is gone" are different facts.
  identityPurgedAt DateTime?

  closedAt DateTime?

  /// The draft report this run became. One report per run.
  reportId String?      @unique
  report   EventReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User     @relation("LiveRunCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  crew LiveRunCrewMember[]

  @@index([state])
  /// The purge sweep, and the 48h readability gate.
  @@index([closedAt])
  @@index([createdById])
  /// Force-closing abandoned runs reads this.
  @@index([updatedAt])
  @@index([localityId])
}

/// Who is on a run in progress.
///
/// The one part of a run that stays relational, because "may this person read
/// this run" is the table's hottest query and the coordinator's board shows
/// names. Replaced wholesale on every PUT, the same way a report's children are.
model LiveRunCrewMember {
  id     String  @id @default(cuid())
  runId  String
  run    LiveRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  roleName String?
  position Int

  @@unique([runId, userId])
  @@index([runId])
  @@index([userId])
}

/// The handful of values that are the same for every run of this delegation.
///
/// A table rather than environment variables so a coordinator can change the
/// freephone number without a deploy, and so "where is our base" has one answer
/// the reports and the distance calculation both read. Exactly one row: the id
/// is fixed by a CHECK in the migration, so an accidental second row is
/// impossible rather than merely unlikely.
model DelegationSettings {
  id             String   @id @default("delegation")
  baseName       String
  baseLatitude   Float
  baseLongitude  Float
  /// Dialled from the live-run overflow menu; the dial time is stamped on the run.
  coduDadosPhone String
  updatedAt      DateTime @updatedAt
}

// ─── Legacy migration ─────────────────────────────────────────────────────────

/// Maps a row in the legacy MySQL system to the row it became here.
///
/// Kept out of the domain models on purpose: `User`, `Vehicle` and
/// `EventReport` carry no `legacyId` column, so nothing in the application
/// can accidentally depend on where a row came from, and dropping this one
/// table is the whole of "forget the migration ever happened".
///
/// The loader is re-runnable and legacy always wins: on every run it looks a
/// legacy key up here, and either updates the row it points at or creates one
/// and records it. `sourceHash` is the SHA-256 of the normalised source tuple,
/// stored so a future "only overwrite rows the app hasn't touched" mode has
/// something to compare against — nothing reads it today.
model LegacyIdMap {
  id       String @id @default(cuid())
  /// The target model name, e.g. "User", "EventReport", "VehicleInventoryItem".
  entity   String
  /// The legacy primary key, rendered as a single string. Composite keys are
  /// joined with "|" in the source table's own PK order — e.g. a `saidas` row
  /// is "1835|2026" and a `Material` row is "12|Luvas M". One spelling of that
  /// rule lives in `legacyKey()`; never build one by hand at a call site.
  legacyId String
  /// The cuid of the row in this database.
  newId    String

  /// SHA-256 (hex) of the normalised source tuple this row was last written
  /// from. Written on every apply run; read by nothing yet.
  sourceHash  String
  /// Which run first created the mapping, and which last confirmed it — a
  /// mapping whose `lastRunId` is stale means the legacy row has disappeared.
  firstRunId  String
  lastRunId   String
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @updatedAt

  /// One legacy row maps to at most one target row, and one target row is
  /// claimed by at most one legacy row — both directions, so a bug that
  /// re-points a mapping fails loudly instead of orphaning a row.
  @@unique([entity, legacyId])
  @@unique([entity, newId])
  @@index([entity])
  @@index([lastRunId])
}
